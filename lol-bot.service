[Unit]
Description=Jeff Bot — League of Legends Discord Stats Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/Jeff-Bot
ExecStart=/home/YOUR_USERNAME/Jeff-Bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
