# --- Discord (required) ---
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_discord_server_id_here
CHANNEL_ID=your_discord_channel_id_here

# --- Riot API (required) ---
RIOT_API_KEY=your_riot_api_key_here
REGION=na1
ROUTING=americas

# --- DeepSeek API (optional — unlocks AI coaching, VOD reviews, scouting, /ask, /comp, /roast) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_ENABLED=true

# --- Optional overrides ---
# TIMEZONE=America/Denver
# DAILY_HOUR=8
# WEEKLY_DAY=mon
# WEEKLY_HOUR=9
# RANK_CHECK_INTERVAL_HOURS=2
# ANNOUNCE_DEMOTIONS=true
# SQUAD_DEBRIEF_ENABLED=true
# SQUAD_CHECK_INTERVAL_MINUTES=10
