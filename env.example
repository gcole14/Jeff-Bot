# --- Discord (required) ---
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_discord_server_id_here
CHANNEL_ID=your_discord_channel_id_here

# --- Riot API (required) ---
RIOT_API_KEY=your_riot_api_key_here
REGION=na1
ROUTING=americas

# --- DeepSeek API (optional — unlocks AI coaching, VOD reviews, scouting, /ask, /comp, /roast) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_ENABLED=true

# --- Optional overrides ---
# TIMEZONE=America/Denver
# DAILY_HOUR=8
# WEEKLY_DAY=mon
# WEEKLY_HOUR=9
# RANK_CHECK_INTERVAL_HOURS=2
# ANNOUNCE_DEMOTIONS=true
# SQUAD_DEBRIEF_ENABLED=true
# SQUAD_CHECK_INTERVAL_MINUTES=10
# SUMMONERS=Cookmysock#cook,31Sec#LCPM,SwimboSlice#pizza,H1ph0pp3r#8008

# --- Hybrid Voice / TTS (optional — unlocks /voice commands) ---
# Primary: Windows RTX 5070 Ti voice_worker (Chatterbox Turbo + voice cloning)
# VOICE_ENABLED=true
# VOICE_WORKER_URL=http://192.168.1.50:8100
# VOICE_WORKER_TOKEN=
# VOICE_DEFAULT_VOICE=jeff
# Fallback 1: CM3588 Kokoro-82M (`docker compose --profile kokoro up -d`)
# VOICE_FALLBACK_TTS_URL=http://kokoro:8880
# VOICE_FALLBACK_VOICE=am_adam
# VOICE_MAX_CHARS=450
# VOICE_IDLE_MINUTES=15
# Fallback 2: ElevenLabs API (optional)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v4_turbo

# --- Hands-Free Voice Listening ("Hey Jeff" via Desktop GPU Whisper /stt) ---
# Automatically turns on when VOICE_WORKER_URL reports stt_available=true, and self-deafens when PC is off.
# VOICE_LISTEN_ENABLED=true
# VOICE_LISTEN_SILENCE_S=0.7
# VOICE_LISTEN_MIN_S=0.4
# VOICE_LISTEN_MAX_S=15.0
# Wait window (seconds) after a bare "Hey Jeff" before requiring the wake word again (post-response follow-up is off)
# VOICE_LISTEN_FOLLOWUP_S=8.0
# VOICE_LISTEN_HEALTH_INTERVAL_S=30.0
# VOICE_LISTEN_RMS_THRESHOLD=280
# VOICE_LISTEN_CHIME=true
